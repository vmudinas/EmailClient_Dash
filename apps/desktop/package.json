{
  "name": "@email-client/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/main.js",
    "start": "electron dist/main.js",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@email-client/api": "*",
    "@email-client/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.localemailarchive.client",
    "productName": "Archive Mail",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    }
  }
}
