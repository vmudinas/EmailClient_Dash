{
  "name": "@email-client/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch --exclude node_modules --exclude ../../node_modules src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@email-client/shared": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^9.3.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0",
    "mailparser": "^3.9.14",
    "node-mbox": "^2.0.0",
    "nodemailer": "^9.0.3",
    "officeparser": "^7.2.3",
    "openai": "^6.46.0",
    "pst-extractor": "^1.12.0",
    "sanitize-html": "^2.17.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
