# Host paths. Use a local NAS/server volume, never NFS, SMB, Cloud Sync, or Synology Drive.
ARCHIVE_MAIL_DATA_DIR=/srv/archive-mail/data
ARCHIVE_MAIL_BACKUP_DIR=/srv/archive-mail/backups
ARCHIVE_MAIL_BACKUP_RETENTION_DAYS=14
ARCHIVE_MAIL_POSTGRES_DIR=/srv/archive-mail/postgres

# PostgreSQL runs as a private Compose service. Use a long random password.
POSTGRES_DB=archive_mail
POSTGRES_USER=archive_mail
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Re-copy SQLite into PostgreSQL before the application starts after each deployment.
ARCHIVE_MAIL_POSTGRES_MIGRATE_ON_DEPLOY=true

# Set these to the host account that owns ARCHIVE_MAIL_DATA_DIR (`id -u` and `id -g`).
ARCHIVE_MAIL_UID=1000
ARCHIVE_MAIL_GID=1000

# Keep 127.0.0.1 when a reverse proxy runs on this server. Use 0.0.0.0 for direct LAN access.
ARCHIVE_MAIL_BIND_ADDRESS=127.0.0.1
ARCHIVE_MAIL_PORT=3001
ARCHIVE_MAIL_IMAGE_TAG=local
TZ=America/New_York

# Required for Gmail authorization from another computer. Use only the public HTTPS origin.
# The Google Web OAuth authorized redirect URI must be:
# https://mail.example.com/api/gmail/oauth/callback
EMAIL_CLIENT_PUBLIC_URL=
EMAIL_CLIENT_SESSION_MINUTES=720
# Allow normal username/PIN login from another device. Enable only on a trusted LAN or behind HTTPS.
EMAIL_CLIENT_ALLOW_REMOTE_LOGIN=false
# Set true only when port 3001 is loopback/firewall restricted behind your reverse proxy.
EMAIL_CLIENT_TRUST_PROXY=false

# Optional Gmail environment management. Leave blank to configure credentials in Admin settings.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_SYNC_INTERVAL_MINUTES=5
# GMAIL_SYNC_MAILBOX_ACTIONS=true

# Optional AI environment fallbacks. Leave blank to manage keys in Admin settings.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional property rent payment providers. Hosted providers collect credentials;
# Archive Mail stores only amount, provider IDs, status, references, and timestamps.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_WEBHOOK_ID=
# ZELLE_RECIPIENT=rent@example.com
# ZELLE_PAYMENT_NOTE=Include the property address in the memo.

# Optional property reminder delivery. The Gmail connection ID comes from Admin settings > Gmail.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=MG...
# PROPERTY_GMAIL_CONNECTION_ID=

# Durable property jobs run in the API process and remain persisted in SQLite.
PROPERTY_AUTOMATION_INTERVAL_MINUTES=5
PROPERTY_BACKUP_RETENTION=7

# Keep one SQLite-writing import active. Messages are committed in short batches,
# and imports slow down temporarily when API latency exceeds the threshold.
EMAIL_IMPORT_CONCURRENCY=1
EMAIL_IMPORT_BATCH_SIZE=50
EMAIL_IMPORT_THROTTLE_MS=5
EMAIL_IMPORT_LATENCY_THRESHOLD_MS=250
